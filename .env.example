# ============================================================
# Groq API Configuration
# Sign up free at https://console.groq.com
# Generate a key at https://console.groq.com/keys
# ============================================================
GROQ_API_KEY=your_groq_api_key_here

# ============================================================
# Model Configuration
# ============================================================
# Main generator (final RAG answer + RAGAS judge)
GROQ_GENERATION_MODEL=llama-3.3-70b-versatile

# Fast model for agent-internal calls (query decomp, self-verify)
GROQ_AGENT_MODEL=llama-3.1-8b-instant

# Embedding model (CPU-friendly, 384-dim)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cross-encoder re-ranker (CPU-tolerable)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ============================================================
# Paths
# ============================================================
CHROMA_PERSIST_DIR=./chroma_db
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed